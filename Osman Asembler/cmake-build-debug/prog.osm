.EQU OUT 0xF8

.DATA
VAR_niz: .BYTE 0, 0, 0
TMP_0: .BYTE 0
TMP_1: .BYTE 0
TMP_2: .BYTE 0
TMP_3: .BYTE 0
TMP_4: .BYTE 0
TMP_5: .BYTE 0
TMP_6: .BYTE 0
TMP_7: .BYTE 0
TMP_8: .BYTE 0
TMP_9: .BYTE 0
TMP_10: .BYTE 0
TMP_RETURN: .BYTE 0
.CODE
MAIN:
LI A, 2
STI A, TMP_0
LI A, 0
STI A, TMP_1
LA C, VAR_niz
LDI B, TMP_1
ADD C, B
LDI A, TMP_0
ST A, C[0]
LI A, 5
STI A, TMP_2
LI A, 1
STI A, TMP_3
LA C, VAR_niz
LDI B, TMP_3
ADD C, B
LDI A, TMP_2
ST A, C[0]
LI A, 0
STI A, TMP_6
LA C, VAR_niz
LDI B, TMP_6
ADD C, B
LD A, C[0]
STI A, TMP_4
LI A, 1
STI A, TMP_7
LA C, VAR_niz
LDI B, TMP_7
ADD C, B
LD A, C[0]
STI A, TMP_5
LDI A, TMP_4
LDI B, TMP_5
ADD A, B
STI A, TMP_8
LI A, 2
STI A, TMP_9
LA C, VAR_niz
LDI B, TMP_9
ADD C, B
LDI A, TMP_8
ST A, C[0]
LI A, 2
STI A, TMP_10
LA C, VAR_niz
LDI B, TMP_10
ADD C, B
LD A, C[0]
STI A, OUT
LI A, 0
STI A, TMP_RETURN
LDI PV, TMP_RETURN
JMP END
END:
JMP END

LDI A, 0xF9
ANDI A, 0x08
CMPI A, 0x01


; Sta radi ovaj LDI PV u mainu?
; Promijeniti out u FF
