.EQU OUT 0xFF

.DATA
VAR_segmenti: .BYTE 63, 6, 91, 79, 102, 109, 125, 7, 127, 111
VAR_ADRESE_DISPLEJA: .BYTE 254, 253, 252
VAR_rez: .BYTE 0

.CODE
MAIN:
LA A, VAR_ADRESE_DISPLEJA
ST A, SP[0]
ADDI SP, 1
LA A, VAR_segmenti
ST A, SP[0]
ADDI SP, 1
LI A, 0
ST A, SP[0]
ADDI SP, 1
CALL displejevi
SUBI SP, 3
MOV A, PV
LDI A, 248
STI A, VAR_rez
LDI A, VAR_rez
ST A, SP[0]
ADDI SP, 1
CALL faktorijel
SUBI SP, 1
MOV A, PV
STI A, VAR_rez
LA A, VAR_ADRESE_DISPLEJA
ST A, SP[0]
ADDI SP, 1
LA A, VAR_segmenti
ST A, SP[0]
ADDI SP, 1
LDI A, VAR_rez
ST A, SP[0]
ADDI SP, 1
CALL displejevi
SUBI SP, 3
MOV A, PV
END:
JMP END
faktorijel:
ST PA, SP[0]
ADDI SP, 1
ST E, SP[0]
ADDI SP, 1
MOV E, SP
LD A, E[-3]
ST A, SP[0]
ADDI SP, 1
LI A, 1
MOV B, A
SUBI SP, 1
LD A, SP[0]
CMP B, A
BGE CMP_TRUE_2
LI A, 0
JMP CMP_END_3
CMP_TRUE_2:
LI A, 1
CMP_END_3:
CMPI A, 0
BEQ IF_END_1
LI A, 1
MOV PV, A
JMP faktorijel_END
IF_END_1:
LD A, E[-3]
ST A, SP[0]
ADDI SP, 1
LD A, E[-3]
ST A, SP[0]
ADDI SP, 1
LI A, 1
MOV B, A
SUBI SP, 1
LD A, SP[0]
SUB A, B
ST A, SP[0]
ADDI SP, 1
CALL faktorijel
SUBI SP, 1
MOV A, PV
MOV B, A
SUBI SP, 1
LD A, SP[0]
LI C, 0
MUL_START_4:
CMPI B, 0
BEQ MUL_END_5
ADD C, A
SUBI B, 1
JMP MUL_START_4
MUL_END_5:
MOV A, C
MOV PV, A
JMP faktorijel_END
faktorijel_END:
MOV SP, E
SUBI SP, 1
LD E, SP[0]
SUBI SP, 1
LD PA, SP[0]
RET
displejevi:
ST PA, SP[0]
ADDI SP, 1
ST E, SP[0]
ADDI SP, 1
MOV E, SP
ADDI SP, 5
NOP
LD A, E[-3]
ST A, E[0]
LI A, 0
ST A, E[1]
FOR_START_6:
LD A, E[1]
ST A, SP[0]
ADDI SP, 1
LI A, 3
MOV B, A
SUBI SP, 1
LD A, SP[0]
CMP A, B
BLT CMP_TRUE_8
LI A, 0
JMP CMP_END_9
CMP_TRUE_8:
LI A, 1
CMP_END_9:
CMPI A, 0
BEQ FOR_END_7
LI A, 0
ST A, E[2]
WHILE_START_10:
LD A, E[0]
ST A, SP[0]
ADDI SP, 1
LI A, 10
MOV B, A
SUBI SP, 1
LD A, SP[0]
CMP A, B
BGE CMP_TRUE_12
LI A, 0
JMP CMP_END_13
CMP_TRUE_12:
LI A, 1
CMP_END_13:
CMPI A, 0
BEQ WHILE_END_11
LD A, E[0]
ST A, SP[0]
ADDI SP, 1
LI A, 10
MOV B, A
SUBI SP, 1
LD A, SP[0]
SUB A, B
ST A, E[0]
LD A, E[2]
ST A, SP[0]
ADDI SP, 1
LI A, 1
MOV B, A
SUBI SP, 1
LD A, SP[0]
ADD A, B
ST A, E[2]
JMP WHILE_START_10
WHILE_END_11:
LD A, E[0]
ST A, E[3]
LD A, E[3]
MOV B, A
LD C, E[-4]
ADD C, B
LD A, C[0]
ST A, E[4]
LD A, E[4]
ST A, SP[0]
ADDI SP, 1
LD A, E[1]
MOV B, A
LD C, E[-5]
ADD C, B
LD A, C[0]
MOV C, A
SUBI SP, 1
LD A, SP[0]
ST A, C[0]
LD A, E[2]
ST A, E[0]
LD A, E[1]
ADDI A, 1
ST A, E[1]
JMP FOR_START_6
FOR_END_7:
displejevi_END:
MOV SP, E
SUBI SP, 1
LD E, SP[0]
SUBI SP, 1
LD PA, SP[0]
RET
