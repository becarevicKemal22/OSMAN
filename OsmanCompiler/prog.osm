.EQU OUT 0xFF

.DATA
VAR_x: .BYTE 0
VAR_y: .BYTE 0

.CODE
MAIN:
NOP
LDI A, 248
STI A, VAR_x
LDI A, 249
LI B, 8
AND A, B
CMPI A, 0
BEQ BIT_IS_ZERO_0
LI A, 1
JMP BIT_END_1
BIT_IS_ZERO_0:
LI A, 0
BIT_END_1:
STI A, VAR_y
LDI A, VAR_x
STI A, 254
LDI A, VAR_y
STI A, 253
LI A, 0
MOV PV, A
JMP END
END:
JMP END
