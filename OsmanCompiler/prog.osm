.EQU OUT 0xFF

.DATA
VAR_x: .BYTE 0
VAR_y: .BYTE 0

.CODE
MAIN:
LI A, 10
STI A, VAR_x
LI A, 10
STI A, VAR_y
LDI A, VAR_y
ST A, SP[0]
ADDI SP, 1
LDI A, VAR_x
ST A, SP[0]
ADDI SP, 1
CALL sab
SUBI SP, 2
MOV A, PV
STI A, VAR_x
LDI A, VAR_x
STI A, 255
LI A, 0
MOV PV, A
JMP END
END:
JMP END
sab:
ST PA, SP[0]
ADDI SP, 1
ST E, SP[0]
ADDI SP, 1
MOV E, SP
LD A, E[-3]
ST A, SP[0]
ADDI SP, 1
LD A, E[-4]
MOV B, A
SUBI SP, 1
LD A, SP[0]
ADD A, B
ST A, E[-3]
LD A, E[-3]
MOV PV, A
JMP sab_END
sab_END:
MOV SP, E
SUBI SP, 1
LD E, SP[0]
SUBI SP, 1
LD PA, SP[0]
RET
