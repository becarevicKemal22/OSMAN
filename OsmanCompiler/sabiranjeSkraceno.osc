
number displejevi(number broj, number* segmenti, number* adrese) {
    number trenutni_broj;
    number i;
    number kolicnik;
    number cifra;
    number kod_za_displej;

    trenutni_broj = broj;
    for(i = 0; i < 3; i++) {
        kolicnik = 0;

        while(trenutni_broj >= 10) {
            trenutni_broj = trenutni_broj - 10;
            kolicnik = kolicnik + 1;
        }

        cifra = trenutni_broj;
        kod_za_displej = segmenti[cifra];
        output(adrese[i], kod_za_displej);

        trenutni_broj = kolicnik;
    }
}

number main(){
    number segmenti[10] = {63, 6, 91, 79, 102, 109, 125, 7, 127, 111};
    number ADRESE_DISPLEJA[3] = {0xFE, 0xFD, 0xFC};
    displejevi(0, segmenti, ADRESE_DISPLEJA);

    number br1;
    number br2;
    while(input(0xF9, 0) != 1){
        br1 = input(0xF8);
        displejevi(br1, segmenti, ADRESE_DISPLEJA);
    }

    while(input(0xF9, 1) != 1){
        br2 = input(0xF8);
        displejevi(br2, segmenti, ADRESE_DISPLEJA);
    }

    displejevi(br1 + br2, segmenti, ADRESE_DISPLEJA);
}
